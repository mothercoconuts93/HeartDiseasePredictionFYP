%% Conceptual Firestore data model.
%% users/{uid} uses the Firebase Authentication UID as its document ID.
%% predictions/{predictionId} uses a Flutter-generated UUID as its document ID.
%% PREDICTION.userId logically references USER.uid; Firestore does not enforce a foreign key.
%% Patient and Practitioner are USER.role values, not separate entities.
%% HealthAssessmentModel is a transient request DTO and is not persisted.
%% Dashboard metrics are calculated dynamically and are not stored entities.

erDiagram
    USER ||--o{ PREDICTION : has

    USER {
        string uid PK "Firebase UID and document ID"
        string fullName
        string email
        string role "Patient or Practitioner"
        datetime createdAt "Logical creation date"
    }

    PREDICTION {
        string predictionId PK "Flutter UUID and document ID"
        string userId FK "Logical reference to USER.uid"
        int prediction
        string riskLevel
        double probability "Percentage from 0 to 100"
        string recommendation
        datetime createdAt "Logical prediction date"
    }
