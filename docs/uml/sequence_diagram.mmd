sequenceDiagram
    autonumber
    actor Patient
    participant Screen as PredictionScreen
    participant Auth as Firebase Authentication
    participant Provider as PredictionProvider
    participant Service as PredictionService
    participant API as FastAPI /predict/v2
    participant Pipeline as Random Forest Pipeline v2
    participant FSService as FirestoreService
    participant Firestore as Cloud Firestore
    participant Result as ResultScreen

    Patient->>Screen: Submit assessment using Run Prediction
    activate Screen
    Screen->>Auth: Read FirebaseAuth.currentUser
    activate Auth
    Auth-->>Screen: Current user or null
    deactivate Auth

    alt Unauthenticated user
        Screen-->>Patient: Show "You must be logged in to run a prediction."
        Screen-->>Patient: Remain outside the prediction workflow
    else Authenticated user
        Screen->>Screen: Validate all form fields

        alt Invalid form
            Screen-->>Patient: Highlight invalid fields and show validation message
        else Valid form
            Screen->>Screen: Construct HealthAssessmentModel
            Screen->>Provider: runPrediction(userId, assessment)
            activate Provider
            Provider->>Service: predictHeartDisease(assessment)
            activate Service
            Service->>API: POST /predict/v2 with assessment JSON
            activate API
            API->>API: Validate PatientDataV2

            alt HTTP, request validation, or API failure
                API-->>Service: HTTP 422, 500, or unavailable response
                Service-->>Provider: Throw PredictionServiceException
                Provider-->>Screen: false with errorMessage
                Screen-->>Patient: Display prediction error
            else Valid API request
                API->>API: Create ordered 15-column DataFrame
                API->>Pipeline: predict() and predict_proba()
                activate Pipeline

                alt Model inference failure
                    Pipeline--xAPI: Raise inference exception
                    API-->>Service: HTTP 500 sanitised error
                    Service-->>Provider: Throw PredictionServiceException
                    Provider-->>Screen: false with errorMessage
                    Screen-->>Patient: Display prediction error
                else Model inference succeeds
                    Pipeline-->>API: Return predicted class and probability
                    API->>API: Classify risk and select recommendation
                    API-->>Service: JSON prediction response
                    Service-->>Provider: Parsed response map
                    Provider->>Provider: Generate UUID and create PredictionModel
                    Provider->>FSService: savePrediction(prediction)
                    activate FSService
                    FSService->>Firestore: Set predictions/{UUID}
                    activate Firestore

                    alt Firestore save failure
                        Firestore--xFSService: Return write error
                        FSService--xProvider: Propagate exception
                        Provider-->>Screen: false with errorMessage
                        Screen-->>Patient: Display save failure
                    else Firestore save succeeds
                        Firestore-->>FSService: Confirm document write
                        FSService-->>Provider: Save completed
                        Provider-->>Screen: true with latestPrediction
                        Screen->>Result: Open with risk, probability and recommendation
                        activate Result
                        Result-->>Patient: Display Analysis Complete
                        deactivate Result
                    end
                    deactivate Firestore
                    deactivate FSService
                end
                deactivate Pipeline
            end
            deactivate API
            deactivate Service
            deactivate Provider
        end
    end
    deactivate Screen
