# Optional absolute path to the trained model. The project model is used by default.
CARDIOGUARD_MODEL_PATH=C:/path/to/HeartDiseasePredictionFYP/machine_learning/heart_model.pkl

# Comma-separated web origins allowed to call FastAPI.
CARDIOGUARD_CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# Python logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Flutter compile-time API setting, passed with --dart-define.
# flutter run --dart-define=CARDIOGUARD_API_URL=https://api.example.com
CARDIOGUARD_API_URL=https://api.example.com
